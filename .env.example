APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sms_gateway
DB_USERNAME=sms_gateway
DB_PASSWORD=secret

SMS_NORMAL_PRICE=100
SMS_EXPRESS_PRICE=100
SMS_RESERVATION_TTL_MINUTES=15
SMS_RETRY_MAX_ATTEMPTS=5
SMS_RETRY_REPUBLISH_BATCH=200

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=sms-gateway
KAFKA_CONSUMER_GROUP=sms-gateway
KAFKA_PORT=9092
KAFKA_TOPIC_NORMAL=normal
KAFKA_TOPIC_EXPRESS=express
KAFKA_TOPIC_EXPRESS_DLQ=express-dlq
KAFKA_CONNECT_TIMEOUT=3
KAFKA_SEND_TIMEOUT=5
KAFKA_RECV_TIMEOUT=5
KAFKA_OFFSET_RESET=earliest
KAFKA_EXPRESS_WORKERS=3
KAFKA_NORMAL_WORKERS=3

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=sms_gateway
CLICKHOUSE_USERNAME=sms_gateway
CLICKHOUSE_PASSWORD=secret

SMS_OPERATOR_URL=http://localhost:8000/provider/sms-operator/receive
SMS_OPERATOR_FAKE_LATENCY_MIN=100
SMS_OPERATOR_FAKE_LATENCY_MAX=2000
SMS_OPERATOR_FAKE_FAILURE_RATE=10
SMS_OPERATOR_FAKE_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
