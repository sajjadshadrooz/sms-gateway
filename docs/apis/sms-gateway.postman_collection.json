        }
      ]
    },
    {
      "name": "SMS operator (fake)",
      "description": "Stand-in for the external SMS operator used in local and test environments. The gateway's workers call this; API consumers never do.",
      "item": [
        {
          "name": "Receive SMS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/provider/sms-operator/receive",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "sms-operator", "receive"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_id\": 42,\n  \"to\": \"+989121234567\",\n  \"message\": \"Your verification code is 123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Deduplicates by `message_id` for 24 hours (`duplicate: true` on repeats). With `SMS_OPERATOR_FAKE_ENABLED=true` it adds random latency and fails a configured percentage of requests with 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or simulated 500', function () { pm.expect(pm.response.code).to.be.oneOf([200, 500]); });",
                  "if (pm.response.code === 200) {",
                  "    pm.test('received', function () { pm.expect(pm.response.json().code).to.eql('sms_message_received'); });",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 Received",
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/provider/sms-operator/receive" },
                "body": { "mode": "raw", "raw": "{\n  \"message_id\": 42,\n  \"to\": \"+989121234567\",\n  \"message\": \"Your verification code is 123456\"\n}" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"message\": \"SMS message received.\",\n  \"code\": \"sms_message_received\",\n  \"duplicate\": false\n}"
            },
            {
              "name": "400 Invalid request",
